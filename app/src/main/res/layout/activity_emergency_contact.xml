<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" app:title="@string/emergency_contact" app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="@string/navigate_back" />
    <include android:id="@+id/sessionLoading" layout="@layout/view_patient_session_loading" />
    <androidx.core.widget.NestedScrollView android:id="@+id/content" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/contact_privacy"
                android:textAppearance="@style/TextAppearance.MediBook.Body" />
            <com.google.android.material.card.MaterialCardView style="@style/Widget.MediBook.FeatureCard"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:orientation="vertical">
                    <TextView android:id="@+id/contactName" android:layout_width="match_parent" android:layout_height="wrap_content" android:saveEnabled="false"
                        android:textAppearance="@style/TextAppearance.Material3.TitleLarge" android:textColor="@color/medibook_text" />
                    <TextView android:id="@+id/contactPhone" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:saveEnabled="false" android:textAppearance="@style/TextAppearance.MediBook.Body" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/changeButton" style="@style/Widget.MediBook.TextButton"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/contact_choose" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/callButton" style="@style/Widget.MediBook.TextButton"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/contact_call" android:visibility="gone" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/removeButton" style="@style/Widget.MediBook.TextButton"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/contact_remove" android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:id="@+id/message" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite" android:saveEnabled="false" android:textAppearance="@style/TextAppearance.MediBook.Body" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
