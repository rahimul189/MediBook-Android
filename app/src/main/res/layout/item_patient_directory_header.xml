<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingBottom="16dp">

    <TextView android:id="@+id/welcomeMessage" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
        android:textColor="@color/medibook_text" android:textStyle="bold" />

    <com.google.android.material.card.MaterialCardView style="@style/Widget.MediBook.FeatureCard"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/appointmentsButton"
                style="@style/Widget.MediBook.TextButton" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/appointment_my" app:icon="@drawable/ic_calendar_cross" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/dashboard_patient_appointments" android:textAppearance="@style/TextAppearance.MediBook.Body" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView android:id="@+id/directoryHeading" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="20dp"
        android:text="@string/patient_directory_title" android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
        android:textColor="@color/medibook_text" android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/searchLayout" style="@style/Widget.MediBook.Input"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="@string/patient_search_hint" app:startIconDrawable="@drawable/ic_search" app:endIconMode="clear_text">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/searchInput" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="textCapWords" android:imeOptions="actionSearch" android:importantForAutofill="no"
            android:maxLength="100" android:maxLines="1" android:saveEnabled="false" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/specializationLayout" style="@style/Widget.MediBook.Input"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="@string/patient_specialization_hint" app:startIconDrawable="@drawable/ic_filter_list"
        app:endIconMode="dropdown_menu">
        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/specializationInput" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="none" android:importantForAutofill="no" android:saveEnabled="false" android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView android:id="@+id/resultCount" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:accessibilityLiveRegion="polite"
        android:textAppearance="@style/TextAppearance.MediBook.Body" android:visibility="gone" />
    <include android:id="@+id/liveUpdates" layout="@layout/view_live_updates" />

</LinearLayout>
