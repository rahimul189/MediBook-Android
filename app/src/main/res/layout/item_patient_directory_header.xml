<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingBottom="16dp">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.MediBook.AuthCard" android:layout_width="match_parent"
        android:layout_height="wrap_content" app:cardBackgroundColor="@color/medibook_teal_container">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="24dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/patient_area_label" android:textColor="@color/medibook_teal_dark"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge" />
            <TextView android:id="@+id/welcomeMessage" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@color/medibook_teal_dark" />
            <TextView android:id="@+id/careHeading" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="@string/patient_home_heading" android:textAppearance="@style/TextAppearance.MediBook.Heading" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="@string/patient_home_placeholder"
                android:textAppearance="@style/TextAppearance.MediBook.Body" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView android:id="@+id/directoryHeading" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="28dp"
        android:text="@string/patient_directory_title" android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
        android:textColor="@color/medibook_text" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="@string/patient_directory_description"
        android:textAppearance="@style/TextAppearance.MediBook.Body" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/searchLayout" style="@style/Widget.MediBook.Input"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="@string/patient_search_hint" app:startIconDrawable="@drawable/ic_search" app:endIconMode="clear_text">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/searchInput" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="textCapWords" android:imeOptions="actionSearch" android:importantForAutofill="no"
            android:maxLength="100" android:maxLines="1" android:saveEnabled="false" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/specializationLayout" style="@style/Widget.MediBook.Input"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="@string/patient_specialization_hint" app:startIconDrawable="@drawable/ic_filter_list"
        app:endIconMode="dropdown_menu">
        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/specializationInput" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="none" android:importantForAutofill="no" android:saveEnabled="false" android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView android:id="@+id/resultCount" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:accessibilityLiveRegion="polite"
        android:textAppearance="@style/TextAppearance.MediBook.Body" android:visibility="gone" />

</LinearLayout>
