<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/Widget.MediBook.AuthCard"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
    android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/medibook_teal_container">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium" android:saveEnabled="false" />
        <TextView android:id="@+id/summary" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textAppearance="@style/TextAppearance.MediBook.Body" android:saveEnabled="false" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
