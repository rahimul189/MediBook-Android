<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.MediBook.FeatureCard" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:layout_marginTop="16dp"
    app:cardBackgroundColor="@color/medibook_blue_container">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/live_title" android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
            android:textColor="@color/medibook_blue" android:textStyle="bold" />
        <TextView android:id="@+id/liveMessage" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:saveEnabled="false" android:accessibilityLiveRegion="polite"
            android:text="@string/live_connecting" android:textAppearance="@style/TextAppearance.MediBook.Body" />
        <com.google.android.material.button.MaterialButton android:id="@+id/liveRetry"
            style="@style/Widget.MediBook.TextButton" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/live_retry" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
