<resources>
    <style name="Widget.MediBook.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="android:layout_marginTop">16dp</item>
    </style>

    <style name="Widget.MediBook.PrimaryButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.MediBook.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/medibook_blue</item>
    </style>

    <style name="Widget.MediBook.AuthCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="TextAppearance.MediBook.Heading" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/medibook_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.MediBook.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/medibook_text_secondary</item>
    </style>
</resources>
